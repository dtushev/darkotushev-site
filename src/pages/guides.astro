---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch all guides from the Keystatic CMS
const guides = await getCollection('guides');
---

<Layout title="Guides & Workflows | Darko Tushev" description="My open-source library of workflows and strategic playbooks.">
    <section class="py-16 md:py-20 max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[#18181B] dark:text-[#F4F4F5] mb-6">
            Guides & Workflows 🛠️
        </h1>
        <p class="text-xl text-[#52525B] dark:text-[#A1A1AA] leading-relaxed mb-12">
            I am always tinkering with new systems to make life a little easier. This is my open-source library where I share my favorite workflows, strategic playbooks, and side projects. Everything here is completely free to use.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {guides.map(guide => (
                <div class="p-6 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white dark:bg-[#09090B] shadow-sm flex flex-col">
                    <h2 class="text-xl font-bold text-[#18181B] dark:text-[#F4F4F5] mb-3">{guide.data.title}</h2>
                    <p class="text-sm text-[#52525B] dark:text-[#A1A1AA] mb-6 flex-grow">{guide.data.description}</p>
                    <a href={`/guides/${guide.id}`} class="text-sm font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">
                        Read Guide &rarr;
                    </a>
                </div>
            ))}
        </div>
    </section>
</Layout>