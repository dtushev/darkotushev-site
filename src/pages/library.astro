---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const resources = await getCollection('library');
---

<Layout title="Library & Reading List | Darko Tushev" description="Curated books, frameworks, and strategic reading recommendations.">
	<section class="py-16 md:py-20 max-w-5xl mx-auto px-4 sm:px-6">
		<h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[#18181B] dark:text-[#F4F4F5] mb-6">
			The Library 📚
		</h1>
		
		<p class="text-xl text-[#52525B] dark:text-[#A1A1AA] leading-relaxed mb-12 max-w-3xl">
			I believe you are what you read. This is a curated list of the books, mental models, and frameworks that have fundamentally shaped how I think about technology, business, and life.
		</p>

		{/* 2-Column Grid for Uniform Box Sizes */}
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			{resources.map(async (resource) => {
                const { Content } = await render(resource);
                const modalId = `modal-${resource.id}`;
                return (
                    <>
                        {/* Clickable Uniform Card */}
                        <div onclick={`document.getElementById('${modalId}').showModal()`} class="cursor-pointer text-left group flex flex-row items-start gap-5 p-5 sm:p-6 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white dark:bg-[#09090B] shadow-sm hover:shadow-md hover:border-blue-200 dark:hover:border-blue-900 transition-all h-full">
                            
                            {/* Thumbnail */}
                            <div class="w-24 sm:w-28 shrink-0 overflow-hidden rounded-md bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-800 aspect-[2/3] relative">
                                {resource.data.coverImage ? (
                                    <img src={resource.data.coverImage} alt={resource.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                                ) : (
                                    <div class="flex h-full items-center justify-center text-gray-400 text-[10px] uppercase font-bold text-center p-2">No Cover</div>
                                )}
                            </div>
                            
                            {/* Clamped Text Content */}
                            <div class="flex flex-col flex-grow h-full overflow-hidden">
                                <span class="text-[10px] font-bold tracking-wider uppercase mb-2 text-blue-600 dark:text-blue-400">
                                    {resource.data.category}
                                </span>
                                <h2 class="text-lg font-bold text-[#18181B] dark:text-[#F4F4F5] mb-1 line-clamp-2 leading-tight">{resource.data.title}</h2>
                                <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-3 border-b border-transparent">By {resource.data.author}</p>
                                
                                {/* Strict 3-line limit ensures boxes never stretch */}
                                <div class="prose prose-sm dark:prose-invert text-[#52525B] dark:text-[#A1A1AA] line-clamp-3 mb-4">
                                    <Content />
                                </div>
                                
                                {/* mt-auto locks this to the bottom of the card */}
                                <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 mt-auto group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">
                                    Expand Resource &rarr;
                                </span>
                            </div>
                        </div>

                        {/* Expanded Full-Screen Modal */}
                        <dialog id={modalId} onclick="this.close()" class="bg-transparent p-0 m-auto backdrop:bg-black/80 backdrop:backdrop-blur-sm shadow-none open:flex flex-col items-center justify-center border-none w-full max-w-4xl px-4 cursor-zoom-out">
                            
                            {/* Inner Modal Container */}
                            <div class="bg-white dark:bg-[#09090B] w-full rounded-2xl border border-gray-200 dark:border-gray-800 shadow-2xl relative flex flex-col md:flex-row overflow-hidden max-h-[85vh] cursor-auto" onclick="event.stopPropagation()">
                                
                                <button onclick={`document.getElementById('${modalId}').close()`} class="absolute top-4 right-4 z-10 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-full w-8 h-8 flex items-center justify-center shadow hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none transition-colors">✕</button>
                                
                                {/* Left Side: Large Image */}
                                <div class="w-full md:w-2/5 bg-gray-50 dark:bg-black/50 p-8 flex items-center justify-center border-b md:border-b-0 md:border-r border-gray-200 dark:border-gray-800 shrink-0">
                                    {resource.data.coverImage ? (
                                        <img src={resource.data.coverImage} alt={resource.data.title} class="w-full h-auto object-contain rounded-lg shadow-sm max-h-64 md:max-h-[60vh]" />
                                    ) : (
                                        <div class="flex aspect-[2/3] w-full items-center justify-center text-gray-400 border border-gray-200 dark:border-gray-800 rounded-lg">No Cover</div>
                                    )}
                                </div>

                                {/* Right Side: Full Text Content */}
                                <div class="w-full md:w-3/5 p-8 md:p-10 overflow-y-auto">
                                    <span class="text-[10px] font-bold tracking-wider uppercase mb-3 inline-block px-2.5 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-md">
                                        {resource.data.category}
                                    </span>
                                    <h2 class="text-3xl font-bold text-[#18181B] dark:text-[#F4F4F5] mb-2">{resource.data.title}</h2>
                                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-8 border-b border-gray-100 dark:border-gray-800 pb-4">By {resource.data.author}</p>
                                    
                                    <div class="prose dark:prose-invert text-[#52525B] dark:text-[#A1A1AA] max-w-none prose-p:leading-relaxed">
                                        <Content />
                                    </div>
                                </div>
                            </div>
                        </dialog>
                    </>
                )
            })}
		</div>
	</section>
</Layout>