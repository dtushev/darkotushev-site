---
<div class="w-full bg-gray-50 dark:bg-[#18181B] border border-gray-200 dark:border-gray-800 rounded-2xl p-8 my-16">
  <h3 class="text-2xl font-semibold text-[#18181B] dark:text-[#F4F4F5] mb-2">Subscribe to Field Notes</h3>
  <p class="text-[#52525B] dark:text-[#A1A1AA] mb-6">Get my latest essays on Enterprise AI and Agentic Commerce delivered straight to your inbox.</p>
  
  <form class="flex flex-col sm:flex-row gap-3">
    <input 
      type="email" 
      placeholder="Enter your email address" 
      class="flex-grow px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-[#27272A] text-[#18181B] dark:text-[#F4F4F5] focus:outline-none focus:ring-2 focus:ring-blue-500"
      required
    />
    <button 
      type="submit" 
      class="px-6 py-3 bg-[#18181B] dark:bg-[#F4F4F5] text-white dark:text-[#18181B] font-medium rounded-lg hover:opacity-90 transition-opacity"
    >
      Subscribe
    </button>
  </form>
</div>