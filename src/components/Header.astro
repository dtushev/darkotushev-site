---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="w-full max-w-4xl mx-auto px-6 py-8 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight text-[#18181B] dark:text-[#F4F4F5] hover:opacity-80 transition-opacity">
        Darko.
    </a>
    <nav class="flex items-center gap-5 md:gap-6 text-sm font-medium text-[#52525B] dark:text-[#A1A1AA]">
        <a href="/articles" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Articles</a>
        <a href="/guides" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Guides</a>
        <a href="/library" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Library</a>
        <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">About</a>
        <a href="/contact" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contact</a>
        
        <!-- Subtle divider line -->
        <div class="w-px h-4 bg-gray-300 dark:bg-gray-700 mx-1 hidden sm:block"></div>
        
        <!-- The Toggle Component -->
        <ThemeToggle />
    </nav>
</header>