---
const { title, text } = Astro.props;
---
<div class="bg-[#F0F5F5] dark:bg-[#0F172A] p-6 sm:p-8 rounded-lg flex flex-col sm:flex-row gap-4 sm:gap-8 items-start my-8 border border-[#E2E8F0] dark:border-gray-800">
    <div class="text-[#2C7A7B] dark:text-[#4FD1C5] font-bold text-sm tracking-widest uppercase shrink-0 sm:w-48 pt-1">
        {title}
    </div>
    <div class="text-[#374151] dark:text-[#E2E8F0] m-0 leading-relaxed">
        {text}
    </div>
</div>